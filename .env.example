# Copy to .env and fill in. .env is git-ignored: never commit real keys.
# Every setting the project reads is listed here (a test checks this).

# --- Models ----------------------------------------------------------------
# Format: <provider>:<model>. Providers: anthropic, google_genai, openai.
# Model for agents:
AFR_LLM_MODEL=anthropic:claude-sonnet-5-5
# Cheaper model for the LLM judge and bulk work:
AFR_LLM_CHEAP_MODEL=anthropic:claude-haiku-5-5

# --- Provider keys (only the ones you use) ----------------------------------
# Anthropic: local development and bulk runs only.
# Never put it in GitHub secrets, CI or the deployed instance.
ANTHROPIC_API_KEY=

# Google Gemini API, free tier, from a personal Google AI Studio account.
# Also stored as a GitHub Actions secret for evals in CI.
GOOGLE_API_KEY=

# OpenAI (optional; not used by default).
OPENAI_API_KEY=

# --- Run store ---------------------------------------------------------------
# SQLAlchemy URL. Leave commented out to use compose.yaml's local Postgres.
# AFR_DATABASE_URL=postgresql+psycopg://afr:afr@127.0.0.1:5433/afr

# --- Redaction ---------------------------------------------------------------
# Key for the fingerprints in redaction placeholders ([REDACTED:openai_key:1a2b3c4d]).
# Leave commented out locally: one is generated into ~/.afr/redaction.key.
# Set it when deployed (Secret Manager). Never store it in the database.
# Make one with: python -c "import secrets; print(secrets.token_hex(32))"
# AFR_REDACTION_KEY=

# --- Claude Code hook (docs/claude-code.md) ---------------------------------
# User-level folder for the redaction key and the hook's spool and state (default ~/.afr).
# The hook reads only environment variables (it runs in other projects' folders), so set
# AFR_HOME, AFR_REDACTION_KEY and AFR_HOOK_URL in the environment, not here.
# AFR_HOME=
