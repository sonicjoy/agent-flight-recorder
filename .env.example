# Copy to .env and fill in. .env is git-ignored: never commit real keys.
# Every setting the project reads is listed here.

# --- LLM providers (used from #2) ---------------------------------------

# Anthropic API key, for local development and bulk runs only.
# Never put it in GitHub secrets, CI or the deployed instance.
ANTHROPIC_API_KEY=

# GitHub token with access to GitHub Models, for running against GitHub Models locally.
# In CI the workflow's own GITHUB_TOKEN is used instead.
GITHUB_TOKEN=

# Model for agents, and a cheaper model for the LLM judge and bulk work.
# Format: <provider>:<model>, e.g. anthropic:claude-sonnet-5-5
AFR_LLM_MODEL=anthropic:claude-sonnet-5-5
AFR_LLM_CHEAP_MODEL=anthropic:claude-haiku-5-5
